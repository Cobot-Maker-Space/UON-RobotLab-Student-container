{
    "name": "ROS 2 Development Container",
    "privileged": true,
    "remoteUser": "team",
    // The amd64 image published from the linux branch. Gazebo Classic (which the TurtleBot3 Humble
    // simulation needs) has no arm64 packages anywhere, so there is no native Apple Silicon image:
    // Docker Desktop runs this one under Rosetta instead. See decision.md.
    "image": "ghcr.io/cobot-maker-space/robotlab-devcontainer-linux:humble-sim-2026-09",
    "workspaceFolder": "/home/ros2_ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/ros2_ws/src,type=bind",

    // Runs on YOUR machine, before the container is created.
    //  1. start_vnc.sh creates the 'ros' docker network and starts the noVNC container this
    //     container draws on. Without it, "--network=ros" below fails with "network ros not found".
    //  2. pull_image.sh pulls the image above explicitly for linux/amd64. On an Apple Silicon Mac a
    //     plain 'docker pull' of it fails with "no matching manifest for linux/arm64", which is
    //     what VS Code would otherwise do.
    // You can run both by hand: ./.devcontainer/start_vnc.sh {start|stop|status} and ./.devcontainer/pull_image.sh
    "initializeCommand": "bash \"${localWorkspaceFolder}/.devcontainer/start_vnc.sh\" start && bash \"${localWorkspaceFolder}/.devcontainer/pull_image.sh\"",

    "customizations": {
        "vscode": {
            "extensions":[
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "eamodio.gitlens",
                "ms-iot.vscode-ros"
            ]
        }
    },
    
    "containerEnv": {
    // Not a local display - "novnc" is the hostname of the noVNC container on the 'ros' network.
    "DISPLAY": "novnc:0.0",
    "ROS_LOCALHOST_ONLY": "0",
    "ROS_DOMAIN_ID": "30",
    "RMW_IMPLEMENTATION": "rmw_fastrtps_cpp",
    "TURTLEBOT3_MODEL": "waffle",
    // RViz uses MIT-SHM by default, which does not work across a network X connection.
    "QT_X11_NO_MITSHM": "1",
    // Docker Desktop on a Mac has no GPU passthrough, so Gazebo and RViz must render on the
    // CPU. Without this they either crash on startup or fall back unpredictably.
    "LIBGL_ALWAYS_SOFTWARE": "1"
},
    "runArgs": [
    // "--net=host",
     "--network=ros",
    // Run the amd64 image under Rosetta on Apple Silicon (natively on an Intel Mac). Without this,
    // Docker looks for an arm64 image that does not exist.
     "--platform=linux/amd64"
    // Note: --device=/dev/video0 is intentionally omitted on macOS. Docker Desktop runs a Linux
    // VM that cannot pass through host devices, so a webcam bind here fails container creation.
],

    "mounts": [
        
        "source=${localWorkspaceFolder}/../cache/humble/build,target=/home/ros2_ws/build,type=bind",
        "source=${localWorkspaceFolder}/../cache/humble/install,target=/home/ros2_ws/install,type=bind",
        "source=${localWorkspaceFolder}/../cache/humble/log,target=/home/ros2_ws/log,type=bind"
    ],
    // Clones any missing turtlebot3 packages and builds the workspace. Incremental after the
    // first run - see setup.sh.
    "postCreateCommand": "bash /usr/local/bin/setup.sh"
    
    // For first time users and setup use this command, then you can change it to the above one after everything is configured
    // "postCreateCommand": "rm -rf build/* install/* log/* src/* && cd src/ && git clone -b humble https://github.com/ROBOTIS-GIT/DynamixelSDK.git && git clone -b humble https://github.com/ROBOTIS-GIT/turtlebot3.git && git clone -b humble https://github.com/ROBOTIS-GIT/turtlebot3_msgs.git && git clone -b humble https://github.com/ROBOTIS-GIT/turtlebot3_simulations.git && cd .. && colcon build --symlink-install"
}
